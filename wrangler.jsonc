{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "minilytics",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-26",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    // Static files skip the Worker. Anything else (client routes, unknown paths) runs it so missing pages return a real 404.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "minilytics",
      // Replace with the id printed by `npx wrangler d1 create minilytics`.
      "database_id": "58012096-fbd1-41a0-a009-1471de231b9e",
      "migrations_dir": "migrations"
    }
  ]
}
